[Unit]
Description=Lottery Matrix scheduled analysis workers
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=matrix
Group=matrix
WorkingDirectory=/opt/lottery-matrix/current/services/matrix-api
EnvironmentFile=/etc/lottery-matrix/matrix-api.env
Environment=UV_CACHE_DIR=/var/cache/lottery-matrix/uv
# A failed lottery does not prevent the other lottery processes from running.
ExecStart=-/usr/local/bin/uv run python -m app.worker --lottery 今彩539
ExecStart=-/usr/local/bin/uv run python -m app.worker --lottery 天天樂
ExecStart=-/usr/local/bin/uv run python -m app.worker --lottery 六合彩
ExecStart=-/usr/local/bin/uv run python -m app.worker --lottery 大樂透
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/cache/lottery-matrix
